[
  {
    "id": "basic",
    "title": "🏡 1. 玩家基礎與生存旅行指令",
    "desc": "所有一般玩家在日常遊戲中常用到的傳送與通訊功能。",
    "commands": [
      {
        "code": "/sethome",
        "badge": "已驗證玩家",
        "badgeClass": "badge-player",
        "isAdmin": false,
        "effect": "在目前站立的位置設定「家」的座標。"
      },
      {
        "code": "/home",
        "badge": "已驗證玩家",
        "badgeClass": "badge-player",
        "isAdmin": false,
        "effect": "一秒瞬間傳送回設定好的家。"
      },
      {
        "code": "/home <名稱>",
        "badge": "管理員",
        "badgeClass": "badge-player",
        "isAdmin": true,
        "effect": "當開啟多個家權限時，傳送到指定名稱的家（例如 <code>/home mine</code>）。"
      },
      {
        "code": "/msg <玩家ID> <訊息>",
        "badge": "全玩家",
        "badgeClass": "badge-player",
        "isAdmin": false,
        "effect": "發送只有彼此看得到的私密悄悄話（亦可簡寫為 <code>/w</code>）。"
      },
      {
        "code": "/r <訊息>",
        "badge": "全玩家",
        "badgeClass": "badge-player",
        "isAdmin": false,
        "effect": "快速回覆上一則收到的私訊。"
      },
      {
        "code": "/warp <地標名稱>",
        "badge": "已驗證玩家",
        "badgeClass": "badge-player",
        "isAdmin": false,
        "effect": "傳送到伺服器公共地標（需擁有管理員分配的特定權限）。"
      }
    ]
  },
  {
    "id": "bolt",
    "title": "🔐 2. 方塊私人安全鎖 (Bolt)",
    "desc": "保護世界中的容器與特定方塊，防止外人偷竊與破壞。",
    "commands": [
      {
        "code": "/bolt lock",
        "badge": "全玩家",
        "badgeClass": "badge-player",
        "isAdmin": false,
        "effect": "輸入後【右鍵點擊】箱子、門或允許的方塊，直接進行私人鎖定。"
      },
      {
        "code": "/bolt unlock",
        "badge": "全玩家",
        "badgeClass": "badge-player",
        "isAdmin": false,
        "effect": "輸入後【右鍵點擊】自己的箱子，解除鎖定。"
      },
      {
        "code": "/bolt trust <玩家ID>",
        "badge": "全玩家",
        "badgeClass": "badge-player",
        "isAdmin": false,
        "effect": "輸入後【右鍵點擊】自己的箱子，將使用權限共享給朋友。"
      },
      {
        "code": "/bolt info",
        "badge": "全玩家",
        "badgeClass": "badge-player",
        "isAdmin": false,
        "effect": "輸入後【右鍵點擊】任意方塊，查詢該防護的擁有者。"
      },
      {
        "code": "/bolt admin",
        "badge": "管理員",
        "badgeClass": "badge-admin",
        "isAdmin": true,
        "effect": "管理員專用，開啟最高管理模式（可強制拆除、檢查他人鎖定的方塊）。"
      }
    ]
  },
  {
    "id": "lp",
    "title": "👑 3. 身份組與聊天室格式 (LuckPerms 管理指令)",
    "desc": "身為服主的您，用來指派階級、設定聊天室標籤與發放權限的終端指令。",
    "commands": [
      {
        "code": "/lp editor",
        "badge": "管理員",
        "badgeClass": "badge-admin",
        "isAdmin": true,
        "effect": "產生安全網址，開啟網頁版的視覺化權限調整面板。"
      },
      {
        "code": "/lp user <玩家ID> parent set admin",
        "badge": "管理員",
        "badgeClass": "badge-admin",
        "isAdmin": true,
        "effect": "將玩家分配至管理員組（聊天室顯示：綠標 [管理員] + 黃色名字）。"
      },
      {
        "code": "/lp user <玩家ID> parent set verified",
        "badge": "管理員",
        "badgeClass": "badge-admin",
        "isAdmin": true,
        "effect": "將玩家分配至已認證組（聊天室顯示：藍標 [☑已認證] + 白色名字）。"
      },
      {
        "code": "/lp user <玩家ID> parent set default",
        "badge": "管理員",
        "badgeClass": "badge-admin",
        "isAdmin": true,
        "effect": "將玩家降回或指派至普通玩家組（聊天室顯示：灰標 [玩家] + 白色名字）。"
      },
      {
        "code": "/lp group default meta setprefix \"&7[玩家]&f \"",
        "badge": "管理員",
        "badgeClass": "badge-admin",
        "isAdmin": true,
        "effect": "一鍵強制設定新進玩家的灰色標籤與白色名字。"
      },
      {
        "code": "/lp group admin meta setprefix \"&a[管理員]&e \"",
        "badge": "管理員",
        "badgeClass": "badge-admin",
        "isAdmin": true,
        "effect": "一鍵強制設定管理員組的綠色標籤與黃色名字。"
      },
      {
        "code": "/lp group verified meta setprefix \"&b[☑已認證]&f \"",
        "badge": "管理員",
        "badgeClass": "badge-admin",
        "isAdmin": true,
        "effect": "一鍵強制設定認證組的藍色勾勾標籤與白色名字。"
      },
      {
        "code": "/lp group <群組> permission set essentials.warp true",
        "badge": "管理員",
        "badgeClass": "badge-admin",
        "isAdmin": true,
        "effect": "開放指定群組使用 <code>/warp</code> 基本功能。"
      },
      {
        "code": "/lp group <群組> permission set essentials.warps.<地標名稱> true",
        "badge": "管理員",
        "badgeClass": "badge-admin",
        "isAdmin": true,
        "effect": "允許該群組前往特定名稱的地標。"
      },
      {
        "code": "/lp user <玩家ID> permission set essentials.warp true",
        "badge": "管理員",
        "badgeClass": "badge-admin",
        "isAdmin": true,
        "effect": "單獨開放某位特定玩家使用 <code>/warp</code> 基本功能。"
      },
      {
        "code": "/lp user <玩家ID> permission set essentials.warps.<地標名稱> true",
        "badge": "管理員",
        "badgeClass": "badge-admin",
        "isAdmin": true,
        "effect": "單獨允許某位特定玩家前往該特定名稱的地標。"
      },
      {
        "code": "/lp group default permission set essentials.sethome.multiple true",
        "badge": "管理員",
        "badgeClass": "badge-admin",
        "isAdmin": true,
        "effect": "允許普通玩家設定多個家。"
      },
      {
        "code": "/lp group default permission set essentials.sethome.multiple.default true",
        "badge": "管理員",
        "badgeClass": "badge-admin",
        "isAdmin": true,
        "effect": "讓普通玩家繼承設定檔中的數量上限（如 3 個）。"
      }
    ]
  },
  {
    "id": "sys",
    "title": "⚙️ 4. 伺服器核心維護與原版規則 (管理員通用指令)",
    "desc": "進行外掛熱刷新、修改玩家暱稱與調整世界底層規則的最高權限指令。",
    "commands": [
      {
        "code": "/ess reload",
        "badge": "管理員",
        "badgeClass": "badge-admin",
        "isAdmin": true,
        "effect": "修改 config.yml、motd.txt 歡迎訊息或地標語言檔後，一鍵重載刷新生效。"
      },
      {
        "code": "/bolt reload",
        "badge": "管理員",
        "badgeClass": "badge-admin",
        "isAdmin": true,
        "effect": "修改 Bolt 的允許方塊防護清單（例如新增基岩、鑽石磚限制）後，一鍵刷新生效。"
      },
      {
        "code": "/nick <玩家ID> <新暱稱>",
        "badge": "管理員",
        "badgeClass": "badge-admin",
        "isAdmin": true,
        "effect": "幫指定玩家在聊天室換上專屬暱稱（清除輸入 <code>/nick &lt;玩家ID&gt; off</code>）。"
      },
      {
        "code": "/gamerule keep_inventory true",
        "badge": "管理員",
        "badgeClass": "badge-admin",
        "isAdmin": true,
        "effect": "開啟麥塊原版「死亡不掉落（防噴）」功能。"
      }
    ]
  }
]